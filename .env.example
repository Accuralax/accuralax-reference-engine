# Local Ollama is the default
LLM_PROVIDER=local
LLM_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434

# Optional cloud provider
OPENAI_API_KEY=

# Optional AgentOps observability
AGENTOPS_API_KEY=

# API security
# Local development: disabled. Production: api_key + a strong secret.
API_AUTH_MODE=disabled
API_API_KEY=
API_BEARER_TOKEN=
API_CORS_ORIGIN=http://localhost:5173
CREATIVE_API_PORT=8788

# Production Omega runtime (do not commit real values)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OMEGA_WORKER_INTERVAL_SECONDS=30

SAAS_ENFORCEMENT_MODE=disabled
